// ⚠️ ARQUIVO GERADO — não edite à mão.
// Fonte: prisma/schema.prisma · Gerador: scripts/gen-dev-schema.mjs
// Regenerar:  npm run prisma:dev-schema
//
// Schema de DESENVOLVIMENTO LOCAL (SQLite). É o schema de produção com duas
// diferenças que o SQLite exige: o provider e a ausência de enums (os campos
// tipados por enum viram String, com o default em texto).
//
// Uso:  npx prisma db push --schema prisma/schema.dev.prisma
//       npx prisma studio  --schema prisma/schema.dev.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}





// Estado de moderação do perfil (resultado de denúncias avaliadas pelo admin).
//   active   → sem restrição
//   warned   → dono recebeu aviso, perfil segue no ar
//   partial  → algumas seções foram censuradas (ver Profile.hiddenSections)
//   restricted → perfil inteiro retirado do ar (não aparece no público/diretório)


// Situação de uma denúncia na fila do admin.


// Papel de um advogado dentro do escritório (sociedade de advogados).
//   owner  → dono/faturamento (1 por escritório)
//   admin  → edita a página institucional e convida membros
//   member → advogado listado; edita apenas o próprio perfil


// Estado do vínculo do advogado com o escritório.
//   invited → convite enviado; NÃO consome assento nem aparece no grid público
//   active  → consome assento e aparece no grid


model User {
  id         String          @id @default(cuid())
  email      String          @unique
  password   String // hash (argon2)
  createdAt  DateTime        @default(now())
  // ---- Sanções que alcançam a CONTA, não só o perfil ----
  // Ver docs/politica-de-sancoes.md, degraus 4 e 5. Até aqui o painel só
  // alcançava o perfil: dava para tirar a página do ar e não dava para impedir
  // que a mesma pessoa publicasse outra no dia seguinte.
  //
  // Suspensão: o login para de funcionar até `suspendedUntil`. Prazo que vence
  // sozinho é o que separa sanção de punição perpétua — uma conta suspensa e
  // esquecida na fila é uma conta morta que ninguém decidiu matar.
  suspendedAt     DateTime?
  suspendedUntil  DateTime?
  // O motivo é o texto que a pessoa lê. Sem ele a rota recusa.
  suspendedReason String    @default("")
  // Encerramento (degrau 5): definitivo, exige duas mãos e libera o endereço
  // público. Não apaga a linha — o registro da sanção é a defesa dos dois lados
  // (LGPD art. 18 convive com a defesa de direito em processo).
  closedAt        DateTime?
  closedReason    String    @default("")
  profile    Profile?
  // Escritórios dos quais este usuário é dono/faturamento (normalmente 0 ou 1).
  firmsOwned Firm[]
  // Chamados de suporte abertos por este advogado (bug, dúvida, conta).
  tickets    SupportTicket[]
  // Sessões abertas (uma por aparelho). Sair apaga a linha — ver model Session.
  sessions   Session[]
}

// Sessão de login. O cookie HttpOnly leva um segredo aleatório; aqui fica o hash
// dele. É a existência desta linha que faz a sessão valer — sem ela, "sair" só
// apagava o navegador, e uma credencial copiada antes seguia entrando até vencer.
//
// Uma linha por APARELHO: sair no celular não derruba o computador. O painel da
// conta também oferece encerrar todas de uma vez (senha trocada, aparelho perdido).
//
// Não guardamos IP nem navegador aqui: seria dado pessoal a mais para proteger,
// sem uso que justifique.
model Session {
  // Id sorteado pela aplicação (16 bytes), não um cuid: nada nele conta quantas
  // sessões existem nem quando foram criadas.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 do segredo que viaja no cookie. O segredo em si NÃO é guardado — um
  // dump do banco não devolve a sessão de ninguém.
  tokenHash String
  createdAt DateTime @default(now())
  // Vence por inatividade; empurrado para frente enquanto a pessoa usa.
  expiresAt DateTime
  // Teto absoluto: nem renovando a sessão passa daqui. Sem ele, uma sessão usada
  // todo dia viveria para sempre — e um cookie roubado junto com ela.
  absoluteExpiresAt DateTime
  // Veio de um login com "lembrar de mim"? Define a duração e se o cookie
  // sobrevive ao fechar do navegador.
  remember  Boolean  @default(true)

  @@index([userId])
  @@index([expiresAt])
}






// Canal de suporte EXCLUSIVO de quem tem conta. Diferente da denúncia (Report),
// que é pública e trata de conteúdo de terceiros: aqui é o próprio advogado
// falando com a plataforma sobre um problema dela.
//
// Guardamos o contexto técnico (URL e navegador) porque é justamente o que o
// usuário não sabe informar e o que resolve metade dos bugs — e porque pedir
// isso num formulário faria o chamado nunca ser aberto.
model SupportTicket {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      SupportKind   @default(bug)
  subject   String
  message   String
  pageUrl   String        @default("")
  userAgent String        @default("")
  status    SupportStatus @default(open)
  // Resposta/observação do admin, visível para o autor do chamado.
  adminNote String        @default("")
  createdAt DateTime      @default(now())
  handledAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Escritório (sociedade de advogados) — página institucional. Cada advogado listado
// mantém seu Profile individual; o vínculo é feito por FirmMembership. O registro da
// SOCIEDADE é auto-declarado — a plataforma não confere inscrições (ver Profile).
model Firm {
  id             String    @id @default(cuid())
  slug           String    @unique // advoc.me/escritorio/<slug>
  name           String
  oabRegistry    String // registro da SOCIEDADE (≠ OAB individual dos advogados)
  monogram       String    @default("")
  logoUrl        String?
  tagline        String    @default("")
  about          String    @default("")
  city           String    @default("")
  state          String    @default("")
  // Contato INSTITUCIONAL (separado das redes pessoais de cada advogado)
  phone          String?
  email          String?
  whatsapp       String?
  instagram      String?
  linkedin       String?
  // ---- White-label canônico do escritório (membros herdam a marca) ----
  brandAccent    String? // cor de destaque (hex)
  customDomain   String? // domínio próprio (informativo no protótipo)
  // Destino do pedido montado pelo assistente virtual da página:
  //   "institutional" (padrão) → WhatsApp do escritório
  //   "lawyer"                 → WhatsApp do advogado escolhido na conversa
  assistantRoute String    @default("institutional")
  // ---- Plano / assentos (billing real entra depois; hoje é campo, como Profile.plan) ----
  plan           Plan      @default(premium) // escritório opera no tier alto
  seatsPurchased Int       @default(5) // base do plano Escritório inclui 5 assentos

  ownerUserId String
  ownerUser   User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     FirmMembership[]
  invites     FirmInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
}

// Vínculo advogado ↔ escritório. Um advogado pertence a no máximo um escritório
// (profileId @unique). O `order` é apenas para ordenação interna — NUNCA para ranking
// público (Prov. 205/2021 veda destaque/hierarquia): o grid é sempre alfabético.
model FirmMembership {
  id        String           @id @default(cuid())
  role      FirmRole         @default(member)
  status    FirmMemberStatus @default(invited)
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  // Plano individual do advogado no momento em que ele ACEITOU o convite. Enquanto
  // ativo ele usa o tier do escritório; ao sair, volta para este plano — sem isso,
  // quem entra num escritório perderia o plano que já pagava.
  previousPlan String?

  firmId    String
  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([firmId, status])
}

// Convite feito para um e-mail que AINDA NÃO tem conta. FirmMembership exige um
// Profile; este modelo guarda o convite até a pessoa se cadastrar, e o cadastro
// (auth.service) o converte em FirmMembership(invited).
model FirmInvite {
  id        String   @id @default(cuid())
  email     String
  role      FirmRole @default(member)
  createdAt DateTime @default(now())

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, email])
  @@index([email])
}

model Profile {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  // Número AUTO-DECLARADO. A plataforma não confere, não valida e não exibe marca
  // de verificação — o perfil público linka a consulta do CNA (base oficial da OAB),
  // igual em todos os planos. Registro falso é tratado pela moderação (Report com
  // motivo `oab_invalid`). Ver frontend/src/components/ui/CnaLink.tsx.
  oabNumber            String
  headline             String           @default("")
  bio                  String           @default("")
  avatarUrl            String?
  city                 String           @default("")
  state                String           @default("")
  regionNote           String?
  inPerson             Boolean          @default(true)
  online               Boolean          @default(true)
  whatsapp             String?
  email                String?
  scheduling           String?
  // ---- Agendamento ----
  // Modo do botão "Agendar": "off" (sem botão) | "external" (link Calendly/Google,
  // usa `scheduling`) | "assistant" (conversa guiada que monta a mensagem do WhatsApp).
  // "native" é LEGADO: a agenda-calendário foi removida — ela guardava nome, WhatsApp
  // e o assunto do VISITANTE no nosso banco, sem tela que a usasse e sem aviso de
  // privacidade. Perfis antigos com "native" caem para "whatsapp" na leitura.
  schedulingMode       String           @default("external")
  // Config da agenda-calendário removida. Colunas mantidas INERTES: são preferências
  // do próprio advogado (não há dado de terceiro aqui) e derrubá-las custaria outra
  // migração destrutiva sem ganho. Nada as lê hoje.
  bookingWeekdays      String           @default("[1,2,3,4,5]") // JSON de dias (0=dom … 6=sáb)
  bookingStartMin      Int              @default(540) // início do expediente em minutos (09:00)
  bookingEndMin        Int              @default(1080) // fim do expediente (18:00)
  bookingSlotMin       Int              @default(30) // duração de cada horário
  bookingLeadHours     Int              @default(12) // antecedência mínima para marcar
  bookingHorizonDays   Int              @default(30) // até quantos dias à frente é possível marcar
  // ---- Assistente virtual (schedulingMode == "assistant") ----
  // Conversa guiada no perfil: oferece só esta grade, coleta assunto/nome e monta a
  // mensagem para o WhatsApp do advogado. Ver frontend/src/lib/assistant.ts.
  assistantDays        String           @default("[]") // JSON: [{ "weekday": 1, "times": ["09:00"] }]
  assistantDurationMin Int              @default(45) // duração indicativa da conversa
  assistantLeadHours   Int              @default(12) // antecedência mínima para oferecer um horário
  assistantHorizonDays Int              @default(14) // até quantos dias à frente sugerir datas
  assistantGreeting    String           @default("") // frase de abertura (passa pela checagem OAB)
  // ---- Vídeo de apresentação (plano Max) ----
  // Guardamos só o LINK (YouTube/Vimeo) já normalizado — nunca o arquivo. A
  // validação do provedor é do servidor: ver src/video.ts.
  videoUrl             String?
  videoCaption         String           @default("")
  // ---- Cartão de visita impresso (plano Max) ----
  // Só a ESCOLHA do advogado (modelo e o que aparece), em JSON — o conteúdo do
  // cartão sai sempre do perfil, para o papel nunca contradizer a página.
  // Ver frontend/src/lib/cardArt.ts. Vazio = cartão ainda não montado.
  card                 String           @default("")
  plan                 Plan             @default(free)
  theme                String           @default("papel") // ThemeId — ver frontend/src/lib/themes.ts
  views                Int              @default(0)
  published            Boolean          @default(false)
  // Versão da política de publicidade (Provimento) aplicada à última verificação.
  policyVersion        String           @default("Prov. 205/2021")
  // Revisão do conjunto de regras (RULESET_REV) conferida na última verificação.
  // Monitor de mudanças normativas: se a revisão vigente for maior, o perfil é
  // reavaliado e o advogado é avisado. Ver src/oab/compliance.ts (policyOutdated).
  policyRevChecked     Int              @default(0)
  // ---- Identidade própria (white-label) — plano Premium/Escritório ----
  // Não afeta conformidade: o conteúdo segue sujeito ao Prov. 205/2021.
  brandName            String?
  brandAccent          String? // cor de destaque personalizada (hex)
  brandHideWatermark   Boolean          @default(false)
  customDomain         String? // domínio próprio (informativo; DNS fora do escopo do protótipo)
  // ---- Moderação (denúncias) ----
  moderationStatus     ModerationStatus @default(active)
  // Até quando a medida vale. Nulo = sem prazo (só as antigas; toda medida nova
  // tem um). Vencido, o perfil volta sozinho — ver moderacaoVigente().
  moderationUntil      DateTime?
  // Quando a cobrança foi pausada por causa de uma sanção. Serviço pago e
  // indisponível não pode seguir sendo cobrado (CDC art. 51, IV) — e isso é
  // indefensável mesmo quando a restrição é justa.
  billingPausedAt      DateTime?
  // Aviso do admin visível ao dono do perfil (motivo do aviso/restrição).
  moderationNote       String           @default("")
  // Seções censuradas quando moderationStatus == partial. JSON de chaves,
  // ex.: ["bio","socials","area:<id>"]. Aplicado no getBySlug (público).
  hiddenSections       String           @default("[]")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areas          PracticeArea[]
  faqs           Faq[]
  socials        SocialLink[]
  events         LinkEvent[]
  auditLogs      AuditLog[]
  reports        Report[]
  // Vínculo com um escritório (opcional). Presente quando o advogado integra uma sociedade.
  firmMembership FirmMembership?

  @@index([city, state])
}

// Denúncia feita por qualquer visitante sobre um perfil (conteúdo que viola as
// normas da OAB / REGRAS.md). Anônima por padrão; e-mail opcional para retorno.
model Report {
  id            String       @id @default(cuid())
  profileId     String
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Motivo pré-pronto (ver src/moderation/moderation.constants.ts) ou "other".
  reason        String
  // Descrição livre do denunciante (o que/onde viola).
  details       String       @default("")
  // Contato opcional do denunciante para retorno (pode ficar vazio).
  reporterEmail String?
  status        ReportStatus @default(open)
  // Decisão aplicada ao resolver: "warn" | "partial" | "restrict" | "dismiss".
  resolution    String?
  createdAt     DateTime     @default(now())
  handledAt     DateTime?

  @@index([profileId, status])
  @@index([status, createdAt])
}


model PracticeArea {
  id          String  @id @default(cuid())
  label       String
  description String  @default("")
  order       Int     @default(0)
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// Pergunta frequente respondida pelo advogado no perfil (seção "Perguntas
// frequentes"). Recurso dos planos pagos: 2 no Pro, 5 no Max.
//
// Prov. 205/2021: responder dúvidas de forma EDUCATIVA e geral é publicidade
// informativa permitida — a resposta não pode virar captação, promessa de
// resultado, oferta de honorários nem consulta sobre um caso concreto. O texto
// passa pelo checkCompliance como qualquer outro campo do perfil.
model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String  @default("")
  order     Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SocialLink {
  id        String     @id @default(cuid())
  kind      String
  url       String
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind])
}

// Analytics de cliques/visitas
model LinkEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String // "view" | "whatsapp" | "scheduling" | "social:instagram" ...
  createdAt DateTime @default(now())

  @@index([profileId, kind])
}

// Trilha de auditoria imutável das alterações de perfil e do resultado de conformidade.
// Dados pessoais minimizados: guardamos apenas o snapshot da bio (conteúdo público),
// status de compliance e a versão da política. Limpar registros antigos conforme LGPD.
model AuditLog {
  id               String   @id @default(cuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  action           String // "update" | "publish" | "unpublish" | "blocked" | "plan"
  complianceStatus String // "ok" | "warn" | "block"
  policyVersion    String
  bioSnapshot      String   @default("") // conteúdo público da bio no momento
  createdAt        DateTime @default(now())

  @@index([profileId, createdAt])
}

// Camada de política versionada — permite atualizar as regras do Provimento sem
// depender de deploy e manter histórico (ex.: revisão futura do Prov. 205/2021).
model PolicyVersion {
  id          String   @id @default(cuid())
  version     String   @unique // ex.: "Prov. 205/2021"
  rulesetRev  Int      @default(1) // revisão interna do conjunto de regras
  description String   @default("")
  effectiveAt DateTime @default(now())
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Painel de administração
// ---------------------------------------------------------------------------

// Papel de quem entra no painel. As permissões de cada um vivem em
// src/admin/admin-roles.ts — fonte única, com teste que barra rota usando
// permissão que não existe lá.
//
//   owner     → tudo, inclusive criar e desativar administradores
//   moderator → decide moderação e lê a auditoria; não mexe em administradores
//   support   → responde chamados e consulta; NÃO tira perfil do ar
//   readonly  → só lê (script, integração, auditoria externa)


// Quem administra a plataforma. Antes era UM usuário e UMA senha no .env: sem
// papéis, sem autoria e sem como revogar. Cada decisão do painel agora tem nome
// (ver AdminAction), e quem responde suporte não consegue restringir um perfil.
//
// A credencial do .env continua valendo APENAS enquanto esta tabela estiver
// vazia — é a porta de entrada do primeiro administrador (npm run admin:create).
// Criado o primeiro, ela para de funcionar sozinha, sem precisar de deploy.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  // Mesmo formato e custo do hash do advogado (scrypt) — ver src/auth/user-auth.ts.
  passwordHash String
  role         AdminRole @default(support)
  // Segundo fator (TOTP, RFC 6238). Obrigatório para quem decide: owner e
  // moderator entram, mas o painel só libera as ações depois de configurado.
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions AdminSession[]
  actions  AdminAction[]

  @@index([active])
}

// Sessão do painel. Antes vivia num Map em memória: reiniciar a API deslogava
// todo mundo e não havia como derrubar o aparelho de alguém antes do prazo.
//
// O cookie leva um segredo sorteado e vale só em /api/admin — assim ele não
// viaja junto de nenhuma visita a perfil público.
model AdminSession {
  // Sorteado (16 bytes), não cuid: nada nele conta quantas sessões existem.
  id                String    @id
  adminId           String
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  // SHA-256 do segredo que viaja no cookie. O segredo não é guardado.
  tokenHash         String
  createdAt         DateTime  @default(now())
  // Vence por inatividade; empurrado enquanto a pessoa usa o painel.
  expiresAt         DateTime
  // Teto absoluto: nem renovando passa daqui.
  absoluteExpiresAt DateTime
  // Impressão digital curta do IP (não o IP): serve para reconhecer "entrou de
  // um lugar novo" sem guardar endereço de ninguém.
  ipFingerprint     String    @default("")

  @@index([adminId])
  @@index([expiresAt])
}

// Trilha do que o ADMIN fez. Diferente de AuditLog, que é a trilha do perfil
// (o que o advogado mudou): aqui é a plataforma agindo sobre alguém.
//
// Existe para os dois lados: sem ela o advogado não tem como contestar uma
// decisão, e o administrador não tem como se defender de uma acusação de
// censura arbitrária. Nenhuma rota da aplicação atualiza ou apaga estas linhas.
model AdminAction {
  id         String     @id @default(cuid())
  // Nulo quando a ação veio da credencial de emergência do .env (antes de existir
  // o primeiro AdminUser) — mesmo aí, adminLabel diz quem foi.
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  // Nome no MOMENTO da ação: renomear ou desativar alguém não reescreve a história.
  adminLabel String     @default("")
  adminRole  String     @default("")
  // "moderacao.restringir", "conta.suspender", "admin.criar", "sessao.abrir"…
  action     String
  targetType String     @default("") // profile | user | firm | ticket | admin | policy | sessao
  targetId   String     @default("")
  // Obrigatório nas decisões que afetam alguém — é o texto que o usuário recebe.
  reason     String     @default("")
  // JSON minimizado do que mudou. Só os campos alterados, nada de conteúdo
  // pessoal além do que já é público.
  before     String     @default("")
  after      String     @default("")
  // Impressão digital do IP, nunca o endereço.
  ip         String     @default("")
  createdAt  DateTime   @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
