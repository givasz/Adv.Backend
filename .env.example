# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/advocme?schema=public"

# ---------------------------------------------------------------------------
# IA — a CADEIA de provedores.
#
# AI_PROVIDER aceita uma LISTA, e é isso que impede o botão "Gerar com IA" de
# morrer quando uma cota diária estoura. O primeiro que tiver chave e responder
# ganha; quem falha passa a vez, sem ninguém perceber.
#
#   AI_PROVIDER="gemini,groq,openrouter"
#
# Provedores e como está a gratuidade deles (conferido em 31/08/2026 — tier
# grátis é decisão de terceiro e muda sem aviso):
#
#   gemini      GRÁTIS       console: aistudio.google.com/app/apikey
#   groq        GRÁTIS       console: console.groq.com/keys
#               ⚠️ GroqCloud, NÃO é o Grok da xAI. É o melhor reserva que existe:
#               tier grátis de verdade, sem cartão, e muito rápido.
#   openrouter  GRÁTIS       console: openrouter.ai/keys
#               Um endereço, dezenas de modelos, alguns com sufixo ":free".
#               A lista de grátis RODA — confira antes de fixar um:
#               curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
#   cerebras    GRÁTIS       console: cloud.cerebras.ai  (sem cartão, cota por dia)
#   mistral     GRÁTIS       console: console.mistral.ai (plano "Experiment", telefone)
#               Os dois entraram em 04/09/2026 SEM medição contra a API: se o
#               modelo padrão não existir mais, AI_MODEL_<NOME> corrige.
#   xai         CRÉDITO      console: console.x.ai  (o Grok de verdade)
#               ⚠️ NÃO tem tier grátis permanente: é crédito de teste na abertura
#               da conta. Quando acaba, é pago. Prefira o groq como reserva.
#   anthropic   PAGO         console.anthropic.com
#   ollama      LOCAL        só onde o Ollama estiver rodando (dev)
# ---------------------------------------------------------------------------
AI_PROVIDER="ollama"

# CHAVES DE RESERVA: cada variável aceita uma LISTA separada por vírgula. Cota
# estourada (429) ou chave recusada (401/403, e o 400 com que o Google recusa
# chave inválida) rodam para a próxima chave DO MESMO provedor antes de desistir
# dele. A posição fica guardada em memória — a chave queimada não é tentada de
# novo a cada pedido, e reiniciar o processo volta para a primeira (que é o certo:
# a cota diária vira à meia-noite).
GEMINI_API_KEY="AIza...,AIza-reserva-1,AIza-reserva-2"
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-v1-..."
CEREBRAS_API_KEY="csk-..."
MISTRAL_API_KEY="..."
XAI_API_KEY="xai-..."
ANTHROPIC_API_KEY="sk-ant-..."
OLLAMA_URL="http://localhost:11434"

# MODELO de cada elo. Sem nada declarado, cada provedor usa o padrão do catálogo
# (backend/src/ai/provedores.ts) — nenhum depende do .env para subir.
#   AI_MODEL          vale SÓ para o PRIMEIRO da cadeia (era a variável de quando
#                     havia um provedor só, e continua querendo dizer a mesma
#                     coisa). Aplicá-la à cadeia inteira mandaria o nome de um
#                     modelo do Gemini para o Groq, que não o conhece.
#   AI_MODEL_<NOME>   vale para aquele provedor, em qualquer posição.
AI_MODEL="llama3.2:3b"
# AI_MODEL_GEMINI="gemini-flash-lite-latest"
# AI_MODEL_GROQ="llama-3.3-70b-versatile"
# AI_MODEL_OPENROUTER="google/gemma-4-31b-it:free"
# AI_MODEL_CEREBRAS="llama-3.3-70b"
# AI_MODEL_MISTRAL="mistral-small-latest"
# AI_MODEL_XAI="grok-4-fast-non-reasoning"

# ⚠️ Um modelo de reserva mais fraco NÃO afrouxa a conformidade: todo texto
# gerado passa pela mesma checagem da OAB, pelo mesmo laço de reparo dirigido e,
# no fim da fila, pelo mesmo template garantidamente regular. Reserva pior
# escreve mais sem graça — nunca escreve irregular.
#
# É PLANO B, não corrida: um provedor por vez, na ordem escrita. Antes de passar
# a vez, uma falha passageira (5xx, rede) ganha UMA repetição no mesmo provedor;
# quem falhou de verdade DESCANSA 60 s (180 s se estourou o tempo) e os pedidos
# seguintes vão direto à reserva. Vencido o prazo, o principal é sondado e
# retoma o posto sozinho. Sem variável para isso: os prazos vivem em
# backend/src/ai/provedores.ts. A linha "[ia] cadeia de IA: ..." do boot diz
# quantas chaves cada elo tem DE VERDADE — e grita "SEM PLANO B" quando só há um.

# CORS / servidor
# Origens autorizadas do frontend, separadas por vírgula. OBRIGATÓRIA em produção
# (o boot recusa subir sem ela: sem CORS restrito, qualquer site chama a API com
# a sessão de quem estiver logado).
FRONTEND_ORIGIN="http://localhost:5173"
PORT=3333

# TRUST_PROXY=1 SOMENTE quando houver um proxy à frente (Nginx da VPS, Render).
# É o que faz o X-Forwarded-For valer como IP do cliente. Sem proxy, deixe
# desligado: aí o cabeçalho é escrito pelo próprio cliente e zerar o limite de
# tentativas de login vira questão de trocar uma linha do request.
TRUST_PROXY="0"

# ---------------------------------------------------------------------------
# SEGREDOS — em produção (NODE_ENV=production) a API NÃO SOBE com os valores
# abaixo: ADMIN_PASSWORD, ADMIN_SESSION_SECRET e AUTH_SESSION_SECRET precisam ser
# reais (ver backend/src/security/config.ts). Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# Admin — CREDENCIAL DE EMERGÊNCIA do painel.
#
# ⚠️ Ela só vale enquanto NÃO existir nenhum administrador cadastrado: é a porta
# pela qual o primeiro nasce. Criado o primeiro (pelo painel, aba Equipe, ou por
# `npm run admin:create`), ela para de valer sozinha — sem deploy, sem variável
# para lembrar de tirar. Cada administrador passa a ter conta, papel, segundo
# fator e nome no histórico. Ver backend/src/admin/.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="troque-esta-senha"

# Token estático legado (header x-admin-token), para script e curl.
# ⚠️ NÃO VALE MAIS EM PRODUÇÃO: era um bearer sem expiração que, por desenho,
# pulava a checagem de CSRF. Fora de produção ele ainda entra — e mesmo lá,
# apenas como `readonly`: consulta, não decide.
ADMIN_TOKEN="troque-este-token"

# Segredo do token anti-CSRF do painel (HMAC). Valor longo e aleatório.
ADMIN_SESSION_SECRET="troque-por-um-segredo-longo-aleatorio"
# Duração da sessão do painel, em horas (padrão 8, teto absoluto de 24). As
# sessões vivem no banco (tabela AdminSession): reiniciar o processo não desloga
# mais ninguém, e derrubar o aparelho de alguém é um botão na aba Equipe.
ADMIN_SESSION_HOURS=8

# Auth de usuário (advogado) — segredo do token anti-CSRF da sessão (HMAC).
# Se ausente, cai no ADMIN_SESSION_SECRET. Use um valor longo e aleatório.
# (A credencial da sessão em si é sorteada por sessão e guardada como hash; este
# segredo não a assina — ver backend/src/auth/user-auth.ts.)
AUTH_SESSION_SECRET="troque-por-outro-segredo-longo-aleatorio"

# ---------------------------------------------------------------------------
# SESSÃO — cookie HttpOnly, duração e onde as sessões ficam guardadas.
# Tudo aqui é OPCIONAL: os padrões servem tanto ao dev quanto à VPS de hoje.
# ---------------------------------------------------------------------------

# Duração. "Lembrar de mim" marcado no login usa REMEMBER_DAYS de inatividade e
# MAX_DAYS de teto absoluto; desmarcado, a sessão dura HOURS e o cookie morre ao
# fechar o navegador.
AUTH_SESSION_HOURS=12
AUTH_SESSION_REMEMBER_DAYS=30
AUTH_SESSION_MAX_DAYS=180

# Cookie. O SameSite é decidido por requisição (Lax quando o front e a API são do
# mesmo site; None quando não são, como no deploy Netlify + VPS). Preencha só
# para forçar:
#   AUTH_COOKIE_SAMESITE=lax|strict|none
#   AUTH_COOKIE_DOMAIN=".advoc.me"   compartilhar o cookie com subdomínios
#   AUTH_COOKIE_SECURE=1             forçar Secure fora de produção (túnel https)

# Cache em memória da sessão validada, em ms (0 desliga). Evita uma consulta por
# requisição autenticada. ⚠️ É por processo: com mais de um processo servindo a
# API, uma sessão encerrada pode sobreviver esse tanto nos outros — nesse caso
# use SESSION_STORE=redis e AUTH_SESSION_CACHE_MS=0.
AUTH_SESSION_CACHE_MS=15000

# Onde as sessões moram: "prisma" (Postgres, padrão) ou "redis".
# O modo redis exige REDIS_URL e o pacote `ioredis` instalado (npm i ioredis);
# faltando qualquer um dos dois, a API avisa e segue no Postgres.
SESSION_STORE="prisma"
# REDIS_URL="redis://127.0.0.1:6379"

# ---- Cobrança (webhook do provedor de pagamento) ----------------------------
# Segredo compartilhado com o provedor: todo evento chega assinado (HMAC-SHA256
# do corpo CRU, no cabeçalho x-advocme-signature) e a rota confere antes de olhar
# qualquer outra coisa.
#
# SEM ESTE VALOR A ROTA RECUSA TUDO (fail closed) — de propósito. /api/billing/webhook
# é pública por natureza (quem chama é um servidor de fora, sem cookie e sem
# sessão), então a assinatura é a fronteira inteira: aceitar evento não assinado
# seria um upgrade grátis para quem descobrisse a URL.
#
# Em desenvolvimento, qualquer valor longo serve — desde que o mesmo assine os
# pedidos de teste. Em produção, use um segredo aleatório e longo, e o MESMO valor
# no painel do provedor.
# BILLING_WEBHOOK_SECRET="troque-por-um-segredo-longo-aleatorio"
